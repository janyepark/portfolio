{
	// Assets-only Worker: no `main`, no Worker code. SvelteKit's adapter-static
	// prerenders every route into ./build, which Cloudflare serves directly.
	// Videos are not in here — they're in the R2 bucket below, served from
	// media.janyepark.com. See the README.
	"name": "portfolio",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./build"
	}
}
